# React Development Workspace Ignores
node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env.local
.env.development.local
.env.test.local
.env.production.local

# Laravel standard ignores (future-proofing)
/vendor/
/public/build/
/public/hot/
/public/storage
/storage/*.key
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/app/public/*
/bootstrap/cache/*.php
.phpunit.result.cache
.php-cs-fixer.cache
/tests/snapshots/

# Environment configurations
.env
.env.backup
.env.production

# IDE and Editor files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
.Spotlight-V100
.Trashes
._*

# Compiled output
*.map
*.min.js
*.min.css

# Dependency lock files (keep package-lock.json, ignore others)
yarn.lock
pnpm-lock.yaml

# Debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
*.bak
*.swp
