# React Development Workspace Ignores
node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env.local
.env.development.local
.env.test.local
.env.production.local

# Laravel standard ignores (future-proofing)
/vendor/
/public/build/
/public/hot/
/public/storage
/storage/*.key
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/app/public/*
/bootstrap/cache/*.php
.phpunit.result.cache
.php-cs-fixer.cache
/tests/snapshots/

# Environment configurations
.env
.env.backup
.env.production

